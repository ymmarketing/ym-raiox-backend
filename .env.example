# ═══════════════════════════════════════════════════════════════════
#  VARIÁVEIS DE AMBIENTE — Raio-X Estratégico (backend na Vercel)
#
#  ⚠  Este arquivo é só um MODELO. Não coloque chave real aqui.
#     Nunca suba um .env preenchido para o GitHub.
#     Cadastre os valores em: Vercel → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════════════

# ── ASAAS ────────────────────────────────────────────────────────────
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# sandbox | production
ASAAS_ENV=sandbox

# ── ANTHROPIC / INTERPRETAÇÃO ───────────────────────────────────────
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MAX_TOKENS=4000
# RAIOX_REPORT_MAX_TOKENS=6500

# ── UPSTASH REDIS ───────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── PRODUTO ──────────────────────────────────────────────────────────
PRODUCT_PRICE=97
PRODUCT_NAME=Raio-X Estratégico

# ── URLS / CORS ─────────────────────────────────────────────────────
PUBLIC_BASE_URL=https://SEU-PROJETO.vercel.app
SITE_URL=https://seusite.github.io
ALLOWED_ORIGINS=

# ── SEGURANÇA / RELATÓRIO ──────────────────────────────────────────
REQUER_PAGAMENTO_RELATORIO=true
CODIGO_MESTRE=
CODIGO_SALT=YM-RAIOX-2026

# ── RX_DIGITAL_2.0 · EVIDÊNCIAS VISUAIS ─────────────────────────────
# Segredo HMAC compartilhado APENAS entre o backend Vercel e a Edge Function
# privada de upload. Use pelo menos 32 caracteres aleatórios e mantenha o mesmo
# valor nos dois ambientes. Nunca exponha no browser.
RAIOX_EVIDENCE_HMAC_SECRET=

# Vida do token curto de upload em segundos. Código limita entre 60 e 1800.
RAIOX_EVIDENCE_TOKEN_TTL=600

# URL da Edge Function privada que recebe o multipart após validar o token curto.
# Exemplo de staging:
# https://<project-ref>.supabase.co/functions/v1/upload-raiox-evidence
RAIOX_EVIDENCE_UPLOAD_URL=

# Reservado para a futura camada RX_VISION_1.0. Enquanto vazio, o print pode ser
# armazenado e exibido como evidência, mas não recebe análise multimodal automática.
RAIOX_EVIDENCE_ANALYZE_URL=

# IMPORTANTE
# - a autorização de upload usa POST /api/raiox/interpretar com
#   { action: "EVIDENCE_TOKEN", ref } para não consumir uma 13ª função Vercel;
# - o armazenamento de desenvolvimento previsto é bucket privado Supabase;
# - o alvo arquitetural permanece Google Drive + banco apenas com referências;
# - não ativar evidências em produção antes da homologação RX_DIGITAL_2.0.
